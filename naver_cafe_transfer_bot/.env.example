# .env 로 복사한 뒤 값을 채우세요. (.env 는 절대 git 에 커밋하지 마세요 — 로그인 쿠키는 비밀번호와 같습니다)

# 네이버 로그인 쿠키. 브라우저에서 네이버 로그인 → F12 → Application(저장소) → Cookies → https://cafe.naver.com
# 에서 NID_AUT, NID_SES 값을 복사해 아래 형식으로 넣으세요.
NAVER_COOKIE="NID_AUT=여기에값; NID_SES=여기에값"

# 텔레그램 @BotFather 에서 /newbot 으로 받은 토큰
TELEGRAM_BOT_TOKEN=
# 내 채팅 ID (python main.py --find-chat-id 로 확인 가능)
TELEGRAM_CHAT_ID=

# (선택) [search] enabled = true 일 때만 필요 — https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
