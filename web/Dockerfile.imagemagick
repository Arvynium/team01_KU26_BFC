FROM python:3.12-slim AS builder

WORKDIR /src

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        libbz2-dev \
        libfontconfig1-dev \
        libfreetype6-dev \
        libjpeg62-turbo-dev \
        libltdl-dev \
        liblzma-dev \
        libopenjp2-7-dev \
        libpng-dev \
        libtiff-dev \
        libwebp-dev \
        libxml2-dev \
        pkg-config \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

COPY third_party/ImageMagick-6.9.3-9 /src/ImageMagick-6.9.3-9
COPY scripts/normalize_native_scripts.py /src/normalize_native_scripts.py
RUN python3 /src/normalize_native_scripts.py /src/ImageMagick-6.9.3-9 \
    --require configure

WORKDIR /src/ImageMagick-6.9.3-9
RUN ./configure \
        --prefix=/opt/imagemagick \
        --disable-docs \
        --without-perl \
        --without-x \
    && touch configure \
    && make -j"$(nproc)" \
    && make install \
    && /opt/imagemagick/bin/convert --version

FROM python:3.12-slim

ENV PATH="/opt/imagemagick/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/imagemagick/lib"

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libbz2-1.0 \
        libfontconfig1 \
        libfreetype6 \
        libgomp1 \
        libjpeg62-turbo \
        libltdl7 \
        liblzma5 \
        libopenjp2-7 \
        libpng16-16 \
        libtiff6 \
        libwebp7 \
        libxml2 \
        fonts-dejavu-core \
        zlib1g \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/imagemagick /opt/imagemagick
COPY backend/requirements.lock /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && useradd --create-home --uid 10001 bfcworker

COPY services/__init__.py services/photo_worker.py /app/services/
COPY public/relay-gear.png /app/assets/relay-gear.png

USER bfcworker
EXPOSE 8084
CMD ["uvicorn", "services.photo_worker:app", "--host", "0.0.0.0", "--port", "8084"]
