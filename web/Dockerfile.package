FROM python:3.12-slim

WORKDIR /app

COPY backend/requirements.lock /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && useradd --create-home --uid 10001 bfcworker

COPY services/__init__.py services/package_worker.py /app/services/

USER bfcworker
EXPOSE 8087
CMD ["uvicorn", "services.package_worker:app", "--host", "0.0.0.0", "--port", "8087"]
